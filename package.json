{
  "name": "smart-project-autostart",
  "displayName": "Smart Project Autostart",
  "description": "Infers how to start and stop an unfamiliar repo and runs it with one click.",
  "version": "0.1.2",
  "publisher": "bobrowsse-tech",
  "author": {
    "name": "Bob Rowsse Walakira",
    "email": "hello@bobrowsse.com",
    "url": "https://bobrowsse.com"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "smart-project-autostartContainer",
          "title": "Smart Project Autostart",
          "icon": "$(play-circle)"
        }
      ]
    },
    "views": {
      "smart-project-autostartContainer": [
        {
          "id": "smart-project-autostartView",
          "name": "Dashboard",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "projectAutostart.scan",
        "title": "Smart Project Autostart: Scan & Generate Plan"
      },
      {
        "command": "projectAutostart.start",
        "title": "Smart Project Autostart: Start Project"
      },
      {
        "command": "projectAutostart.stop",
        "title": "Smart Project Autostart: Stop Project"
      },
      {
        "command": "projectAutostart.viewLogs",
        "title": "Smart Project Autostart: View Logs"
      },
      {
        "command": "projectAutostart.editRunbook",
        "title": "Smart Project Autostart: Edit Runbook"
      }
    ],
    "languageModelTools": [
      {
        "name": "project_autostart_run",
        "tags": [
          "smart-project-autostart"
        ],
        "toolReferenceName": "project_autostart_run",
        "displayName": "Smart Project Autostart — project_autostart_run",
        "modelDescription": "Starts or stops the current workspace's local development stack using the inferred or saved runbook. Use this when the user asks to run, start, boot up, or stop the project.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "scan",
                "start",
                "stop",
                "status"
              ],
              "description": "scan: (re)generate the runbook. start: bring the stack up. stop: tear it down. status: report what is running."
            }
          },
          "required": [
            "action"
          ]
        }
      }
    ]
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && node esbuild.js --production",
    "test": "vscode-test",
    "test:unit": "npm run check-types && tsx --test src/test/service.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.24.0",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "ignore": "^7.0.9",
    "toml": "^5.0.0",
    "tree-kill": "^1.2.2",
    "yaml": "^2.9.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bobrowsse-tech/smart-project-autostart"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0F766E",
    "theme": "dark"
  },
  "keywords": [
    "autostart",
    "runbook",
    "docker-compose",
    "dev-server",
    "onboarding",
    "productivity"
  ],
  "homepage": "https://github.com/bobrowsse-tech/smart-project-autostart#readme",
  "bugs": {
    "url": "https://github.com/bobrowsse-tech/smart-project-autostart/issues",
    "email": "hello@bobrowsse.com"
  }
}
